# Navidrome / Subsonic Server Credentials
# Replace with your server URL, username, and password
NAVIDROME_URL=https://music.yourdomain.com
NAVIDROME_USER=your_navidrome_username
NAVIDROME_PASSWORD=your_navidrome_password

# Lidarr API v1 Configuration (Required only when using --send-to-lidarr)
# Base URL and API key for your Lidarr instance
LIDARR_URL=https://lidarr.yourdomain.com
LIDARR_API_KEY=your_lidarr_api_key

# Root folder for artists (Optional: auto-selected if Lidarr has exactly 1 root folder)
# E.g. /music or /data/media/music
LIDARR_ROOT_FOLDER=/music

# Quality profile name or numeric ID (Optional: auto-selected if Lidarr has exactly 1 profile)
# E.g. Standard, Any, or profile ID 1
LIDARR_QUALITY_PROFILE=Standard

# Metadata profile name or numeric ID (Optional: auto-selected if Lidarr has exactly 1 profile)
# Note: Ensure the selected metadata profile includes Singles/EPs in Lidarr settings
# if you want missing single tracks to be monitored.
# E.g. Standard, Standard + Singles, or profile ID 1
LIDARR_METADATA_PROFILE=Standard

# Tag applied to all artists created or modified by SpotifyMover (Optional, default: SpotifyMoverTool)
LIDARR_TAG=SpotifyMoverTool
